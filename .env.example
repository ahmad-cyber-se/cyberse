# PostgreSQL. Use an external PostgreSQL service for Hostinger Web/Cloud deployments.
DATABASE_URL=postgresql://cyberse:cyberse@localhost:5432/cyberse
DATABASE_SSL=disable

# Generate a strong random value of at least 32 bytes. Never commit the real value.
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters

# Public production URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000
