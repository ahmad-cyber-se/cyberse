# PostgreSQL (Neon in production, Docker Postgres locally)
DATABASE_URL=postgresql://cyberse:cyberse@localhost:5432/cyberse
DATABASE_SSL=disable

# Generate a strong random value of at least 32 bytes. Never commit the real value.
JWT_SECRET=replace-with-a-secure-random-secret-at-least-32-characters

# Optional: Vercel Blob, required for actual file uploads.
BLOB_READ_WRITE_TOKEN=

# Public base URL. Set to your production domain after DNS is connected.
NEXT_PUBLIC_APP_URL=http://localhost:3000
